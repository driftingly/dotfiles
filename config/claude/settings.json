{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/*:*)",
      "Bash(.husky/*:*)",
      "Bash(awk:*)",
      "Bash(brew:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(code:*)",
      "Bash(composer:*)",
      "Bash(cp:*)",
      "Bash(createdb:*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(docker-compose:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(open:*)",
      "Bash(php artisan:*)",
      "Bash(php:*)",
      "Bash(pnpm:*)",
      "Bash(pwd:*)",
      "Bash(python3:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(sqlite3:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(vendor/bin/*:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(xargs:*)",
      "Bash(yarn:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill(agent-browser:*)",
      "Skill(fix-github-issue:*)",
      "Skill(ray-skill:*)",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__chrome-devtools__*",
      "mcp__laravel-boost__*"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.dev)",
      "Read(./**/.env.dev)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.prod)",
      "Read(./**/.env.prod)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.testing)",
      "Read(./**/.env.testing)",
      "Read(./.env.secrets)",
      "Read(./**/.env.secrets)",
      "Read(./.env.backup)",
      "Read(./**/.env.backup)",
      "Read(./.env.bak)",
      "Read(./**/.env.bak)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "shift@laravel-shift": true,
    "document-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "laravel-shift": {
      "source": {
        "source": "github",
        "repo": "laravel-shift/shift-ai"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "attribution": {
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-doc-dashes.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gh-pr-body.sh",
            "if": "Bash(gh:*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
