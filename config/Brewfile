# Core development tools, installed on every machine (Mac and VM).
# Everything else lives in Brewfile.full.

# Fonts
cask 'font-monaspice-nerd-font'         # https://github.com/githubnext/monaspace - Monaspace with Nerd Font icons

# Binaries
brew 'bash'                             # https://formulae.brew.sh/formula/bash - Latest Bash version
brew 'bat'                              # https://formulae.brew.sh/formula/bat - Cat clone with syntax highlighting and Git integration
brew 'bottom'                           # https://formulae.brew.sh/formula/bottom - Modern top/htop replacement (`btm`)
brew 'coreutils'                        # https://formulae.brew.sh/formula/coreutils - GNU file, shell, and text utilities
brew 'direnv'                           # https://formulae.brew.sh/formula/direnv - Per-directory environment variables via .envrc
brew 'eza'                              # https://formulae.brew.sh/formula/eza - Modern, maintained replacement for ls
brew 'fd'                               # https://formulae.brew.sh/formula/fd - Simple, fast, user-friendly alternative to find
brew 'fnm'                              # https://formulae.brew.sh/formula/fnm - Fast Node.js version manager
brew 'fzf'                              # https://formulae.brew.sh/formula/fzf - Command-line fuzzy finder
brew 'gh'                               # https://formulae.brew.sh/formula/gh - GitHub command-line tool
brew 'ghostscript'                      # https://formulae.brew.sh/formula/ghostscript - PostScript/PDF interpreter (imagemagick PDF support)
brew 'git'                              # https://formulae.brew.sh/formula/git - Distributed revision control system
brew 'git-delta'                        # https://formulae.brew.sh/formula/git-delta - Syntax-highlighting pager for git diffs
brew 'httpie'                           # https://formulae.brew.sh/formula/httpie - User-friendly cURL replacement
brew 'imagemagick'                      # https://formulae.brew.sh/formula/imagemagick - Image manipulation toolkit
brew 'jq'                               # https://formulae.brew.sh/formula/jq - JSON processor
brew 'neovim'                           # https://formulae.brew.sh/formula/neovim - Vim-fork focused on extensibility and agility
brew 'pkgconf'                          # https://formulae.brew.sh/formula/pkgconf - Manage compile and link flags for libraries (provides pkg-config)
brew 'poppler'                          # https://formulae.brew.sh/formula/poppler - PDF rendering library and CLI utilities (pdftoppm, pdftotext)
brew 'ripgrep'                          # https://formulae.brew.sh/formula/ripgrep - Fast recursive search (rg)
brew 'trash'                            # https://formulae.brew.sh/formula/trash - Manage the Trash bin
brew 'tree'                             # https://formulae.brew.sh/formula/tree - List directories in a tree structure
brew 'wget'                             # https://formulae.brew.sh/formula/wget - Internet file retriever
brew 'yq'                               # https://formulae.brew.sh/formula/yq - YAML processor (jq for YAML)
brew 'zoxide'                           # https://formulae.brew.sh/formula/zoxide - Smarter cd command (`z`)
brew 'zsh-autosuggestions'              # https://formulae.brew.sh/formula/zsh-autosuggestions - Fish-style autosuggestions for zsh
brew 'zsh-syntax-highlighting'          # https://formulae.brew.sh/formula/zsh-syntax-highlighting - Fish-style syntax highlighting for zsh

# Apps
cask '1password'
cask '1password-cli'
cask 'claude'
cask 'claude-code'
cask 'ghostty'
cask 'google-chrome'
cask 'herd'
cask 'tableplus'
cask 'visual-studio-code'
