#!/bin/bash
#
# Update dotfiles and tools

set -e

source "$(dirname "$0")/lib.sh"

echo ""
step "Updating dotfiles"
echo ""

# Update dotfiles repo. Fast-forward only, and never over local edits: pulling
# onto a dirty tree fails under the repo's pull.rebase setting, which would
# take the rest of this script down with it.
step "Pulling latest changes"
if [ -n "$(git -C ~/.dotfiles status --porcelain)" ]; then
    warn "Uncommitted changes in ~/.dotfiles, skipping pull"
else
    git -C ~/.dotfiles pull --ff-only origin main || warn "Pull failed (diverged from origin?)"
fi
success "Dotfiles updated"

# Update Homebrew and packages. Each step warns rather than aborting, so one
# broken formula does not skip everything below.
PROFILE=$(read_profile)
step "Updating Homebrew packages ($PROFILE profile)"
brew update || warn "brew update failed"
brew upgrade || warn "brew upgrade failed"
brew_bundle "$PROFILE"
brew cleanup || warn "brew cleanup failed"
success "Homebrew packages updated"

check_installer_casks

# Update Oh My Zsh
step "Updating Oh My Zsh"
if [ -d ~/.oh-my-zsh ]; then
    env ZSH=~/.oh-my-zsh zsh ~/.oh-my-zsh/tools/upgrade.sh || warn "Oh My Zsh update failed"
fi
success "Oh My Zsh updated"

# Update manually-cloned zsh plugins
step "Updating zsh plugins"
for plugin in ~/.dotfiles/zsh/plugins/*/; do
    [ -d "$plugin/.git" ] && git -C "$plugin" pull --ff-only || warn "Failed to update $(basename "$plugin")"
done
success "Zsh plugins updated"

install_npm_globals

step "Updating installed skills"
if command -v npx &>/dev/null; then
    npx -y skills@latest update -g -y || warn "Skill update failed"
fi
success "Skills updated"

# Done
echo ""
success "Update complete!"
echo ""
warn "Restart your terminal or run: exec zsh"
echo ""
